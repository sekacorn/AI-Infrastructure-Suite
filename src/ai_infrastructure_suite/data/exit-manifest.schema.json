{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "schema_version": {
   "const": "exit-manifest.v1"
  },
  "vectors": {
   "type": "object",
   "propertyNames": {
    "enum": [
     "policies",
     "prompts",
     "embeddings",
     "fine_tunes",
     "memory",
     "audit_history",
     "cost_history",
     "tool_connectors",
     "identities",
     "ontology",
     "contract_terms",
     "model_providers"
    ]
   },
   "additionalProperties": {
    "type": "object",
    "properties": {
     "state": {
      "enum": [
       "restore_tested",
       "importer_validated",
       "exported",
       "reconstruction",
       "non_exportable",
       "inapplicable",
       "attested",
       "embedding_inventory"
      ]
     },
     "path": {
      "type": "string",
      "maxLength": 240,
      "pattern": "^[a-zA-Z0-9_][a-zA-Z0-9_.-]*(/[a-zA-Z0-9_][a-zA-Z0-9_.-]*)*$"
     },
     "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
     },
     "re_embed_records": {
      "description": "Optional re-embed-record.v1 documents describing rebuilds of stores in this vector's evidence. Only meaningful on the embeddings vector. Each record must bind to that evidence by digest and store_id or it is refused.",
      "type": "array",
      "maxItems": 64,
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "path",
        "sha256"
       ],
       "properties": {
        "path": {
         "type": "string",
         "maxLength": 240,
         "pattern": "^[a-zA-Z0-9_][a-zA-Z0-9_.-]*(/[a-zA-Z0-9_][a-zA-Z0-9_.-]*)*$"
        },
        "sha256": {
         "type": "string",
         "pattern": "^[0-9a-f]{64}$"
        }
       }
      }
     }
    },
    "required": [
     "state",
     "path",
     "sha256"
    ],
    "additionalProperties": false
   },
   "properties": {
    "memory": {
     "oneOf": [
      {
       "type": "object",
       "properties": {
        "state": {
         "enum": [
          "restore_tested",
          "importer_validated",
          "exported",
          "reconstruction",
          "non_exportable",
          "inapplicable",
          "attested",
          "embedding_inventory"
         ]
        },
        "path": {
         "type": "string",
         "maxLength": 240,
         "pattern": "^[a-zA-Z0-9_][a-zA-Z0-9_.-]*(/[a-zA-Z0-9_][a-zA-Z0-9_.-]*)*$"
        },
        "sha256": {
         "type": "string",
         "pattern": "^[0-9a-f]{64}$"
        },
        "re_embed_records": {
         "description": "Optional re-embed-record.v1 documents describing rebuilds of stores in this vector's evidence. Only meaningful on the embeddings vector. Each record must bind to that evidence by digest and store_id or it is refused.",
         "type": "array",
         "maxItems": 64,
         "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
           "path",
           "sha256"
          ],
          "properties": {
           "path": {
            "type": "string",
            "maxLength": 240,
            "pattern": "^[a-zA-Z0-9_][a-zA-Z0-9_.-]*(/[a-zA-Z0-9_][a-zA-Z0-9_.-]*)*$"
           },
           "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
           }
          }
         }
        }
       },
       "required": [
        "state",
        "path",
        "sha256"
       ],
       "additionalProperties": false
      },
      {
       "description": "An agent-memory.v1 export, scored by the scanner. Optional import_report: the agent-memory-import.v1 a destination wrote when it imported this export, bound to it by digest. Suite 0.2.0b2 and earlier refuse this state.",
       "type": "object",
       "additionalProperties": false,
       "required": [
        "state",
        "path",
        "sha256"
       ],
       "properties": {
        "state": {
         "const": "memory_inventory"
        },
        "path": {
         "type": "string",
         "maxLength": 240,
         "pattern": "^[a-zA-Z0-9_][a-zA-Z0-9_.-]*(/[a-zA-Z0-9_][a-zA-Z0-9_.-]*)*$"
        },
        "sha256": {
         "type": "string",
         "pattern": "^[0-9a-f]{64}$"
        },
        "import_report": {
         "type": "object",
         "additionalProperties": false,
         "required": [
          "path",
          "sha256"
         ],
         "properties": {
          "path": {
           "type": "string",
           "maxLength": 240,
           "pattern": "^[a-zA-Z0-9_][a-zA-Z0-9_.-]*(/[a-zA-Z0-9_][a-zA-Z0-9_.-]*)*$"
          },
          "sha256": {
           "type": "string",
           "pattern": "^[0-9a-f]{64}$"
          }
         }
        }
       }
      }
     ]
    },
    "model_providers": {
     "description": "Rubric 2. Accepts only provider_inventory (a provider-inventory.v1 document, with optional tested_alternatives) or inapplicable. Suite 0.1.0b4 and earlier refuse a manifest that declares this vector.",
     "type": "object",
     "additionalProperties": false,
     "required": [
      "state",
      "path",
      "sha256"
     ],
     "properties": {
      "state": {
       "enum": [
        "provider_inventory",
        "inapplicable"
       ]
      },
      "path": {
       "type": "string",
       "maxLength": 240,
       "pattern": "^[a-zA-Z0-9_][a-zA-Z0-9_.-]*(/[a-zA-Z0-9_][a-zA-Z0-9_.-]*)*$"
      },
      "sha256": {
       "type": "string",
       "pattern": "^[0-9a-f]{64}$"
      },
      "tested_alternatives": {
       "description": "model-swap-evidence.v1 documents. Each must bind to exactly one inventory provider and model, and agree with its own numbers, or it is refused. Only with provider_inventory.",
       "type": "array",
       "maxItems": 64,
       "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "path",
         "sha256"
        ],
        "properties": {
         "path": {
          "type": "string",
          "maxLength": 240,
          "pattern": "^[a-zA-Z0-9_][a-zA-Z0-9_.-]*(/[a-zA-Z0-9_][a-zA-Z0-9_.-]*)*$"
         },
         "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
         }
        }
       }
      }
     },
     "if": {
      "properties": {
       "state": {
        "const": "inapplicable"
       }
      }
     },
     "then": {
      "not": {
       "required": [
        "tested_alternatives"
       ]
      }
     }
    },
    "tool_connectors": {
     "oneOf": [
      {
       "type": "object",
       "properties": {
        "state": {
         "enum": [
          "restore_tested",
          "importer_validated",
          "exported",
          "reconstruction",
          "non_exportable",
          "inapplicable",
          "attested",
          "embedding_inventory"
         ]
        },
        "path": {
         "type": "string",
         "maxLength": 240,
         "pattern": "^[a-zA-Z0-9_][a-zA-Z0-9_.-]*(/[a-zA-Z0-9_][a-zA-Z0-9_.-]*)*$"
        },
        "sha256": {
         "type": "string",
         "pattern": "^[0-9a-f]{64}$"
        },
        "re_embed_records": {
         "description": "Optional re-embed-record.v1 documents describing rebuilds of stores in this vector's evidence. Only meaningful on the embeddings vector. Each record must bind to that evidence by digest and store_id or it is refused.",
         "type": "array",
         "maxItems": 64,
         "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
           "path",
           "sha256"
          ],
          "properties": {
           "path": {
            "type": "string",
            "maxLength": 240,
            "pattern": "^[a-zA-Z0-9_][a-zA-Z0-9_.-]*(/[a-zA-Z0-9_][a-zA-Z0-9_.-]*)*$"
           },
           "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
           }
          }
         }
        }
       },
       "required": [
        "state",
        "path",
        "sha256"
       ],
       "additionalProperties": false
      },
      {
       "description": "A tool-inventory.v1 document, scored by the scanner. Optional approvals: the tool-approvals.v1 file the operator committed, bound by digest. Suite 0.2.0b3 and earlier refuse this state.",
       "type": "object",
       "additionalProperties": false,
       "required": [
        "state",
        "path",
        "sha256"
       ],
       "properties": {
        "state": {
         "const": "tool_inventory"
        },
        "path": {
         "type": "string",
         "maxLength": 240,
         "pattern": "^[a-zA-Z0-9_][a-zA-Z0-9_.-]*(/[a-zA-Z0-9_][a-zA-Z0-9_.-]*)*$"
        },
        "sha256": {
         "type": "string",
         "pattern": "^[0-9a-f]{64}$"
        },
        "approvals": {
         "type": "object",
         "additionalProperties": false,
         "required": [
          "path",
          "sha256"
         ],
         "properties": {
          "path": {
           "type": "string",
           "maxLength": 240,
           "pattern": "^[a-zA-Z0-9_][a-zA-Z0-9_.-]*(/[a-zA-Z0-9_][a-zA-Z0-9_.-]*)*$"
          },
          "sha256": {
           "type": "string",
           "pattern": "^[0-9a-f]{64}$"
          }
         }
        }
       }
      }
     ]
    }
   }
  }
 },
 "required": [
  "schema_version",
  "vectors"
 ],
 "additionalProperties": false
}
