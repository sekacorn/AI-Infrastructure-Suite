{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "exit-report.v1"
    },
    "rubric_version": {
      "const": "1"
    },
    "suite_version": {
      "type": "string"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "vectors": {
      "type": "object",
      "required": [
        "policies",
        "prompts",
        "embeddings",
        "fine_tunes",
        "memory",
        "audit_history",
        "cost_history",
        "tool_connectors",
        "identities",
        "ontology",
        "contract_terms"
      ],
      "propertyNames": {
        "enum": [
          "policies",
          "prompts",
          "embeddings",
          "fine_tunes",
          "memory",
          "audit_history",
          "cost_history",
          "tool_connectors",
          "identities",
          "ontology",
          "contract_terms"
        ]
      },
      "additionalProperties": {
        "$ref": "#/$defs/vector"
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "version": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
          "version",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "restore_profiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/restore_profile"
      }
    },
    "legal_notice": {
      "const": "Contract terms are operator-attested. This report is not legal advice."
    }
  },
  "required": [
    "schema_version",
    "rubric_version",
    "suite_version",
    "manifest_sha256",
    "vectors",
    "components",
    "legal_notice"
  ],
  "additionalProperties": false,
  "$defs": {
    "restore_profile": {
      "type": "object",
      "properties": {
        "evidence_path": {
          "type": "string",
          "maxLength": 240
        },
        "run_kind": {
          "enum": ["fanout", "chain"]
        },
        "profile": {
          "enum": ["mock-azure", "mock-aws", "local-ollama"]
        },
        "hop_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "state": {
          "enum": ["passed", "failed"]
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "evidence_path",
        "run_kind",
        "profile",
        "hop_index",
        "state",
        "reason"
      ],
      "additionalProperties": false
    },
    "vector": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "unknown"
            },
            "score": {
              "const": 100
            },
            "verification_level": {
              "const": "unverified"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "state",
            "score",
            "verification_level",
            "reason"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "enum": [
                "restore_tested",
                "restore_failed",
                "importer_validated",
                "exported",
                "reconstruction",
                "non_exportable",
                "inapplicable",
                "attested"
              ]
            },
            "score": {
              "enum": [
                0,
                25,
                50,
                75,
                100,
                null
              ]
            },
            "reason": {
              "type": "string"
            },
            "verification_level": {
              "enum": ["verified", "verified (fake profiles)", "attested"]
            },
            "path": {
              "type": "string",
              "maxLength": 240,
              "pattern": "^[a-zA-Z0-9_][a-zA-Z0-9_.-]*(/[a-zA-Z0-9_][a-zA-Z0-9_.-]*)*$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "state",
            "score",
            "reason",
            "verification_level",
            "path",
            "sha256"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "state": {
                    "const": "restore_tested"
                  }
                }
              },
              "then": {
                "properties": {
                  "score": {
                    "const": 0
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "state": {
                    "const": "restore_failed"
                  }
                }
              },
              "then": {
                "properties": {
                  "score": {
                    "const": 100
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "state": {
                    "const": "importer_validated"
                  }
                }
              },
              "then": {
                "properties": {
                  "score": {
                    "const": 25
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "state": {
                    "const": "exported"
                  }
                }
              },
              "then": {
                "properties": {
                  "score": {
                    "const": 50
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "state": {
                    "const": "reconstruction"
                  }
                }
              },
              "then": {
                "properties": {
                  "score": {
                    "const": 75
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "state": {
                    "const": "non_exportable"
                  }
                }
              },
              "then": {
                "properties": {
                  "score": {
                    "const": 100
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "state": {
                    "const": "inapplicable"
                  }
                }
              },
              "then": {
                "properties": {
                  "score": {
                    "const": null
                  }
                }
              }
            }
          ]
        }
      ]
    }
  }
}
