{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sekacorn/AI-Infrastructure-Suite/schemas/endpoint-locality-cases.v1.json",
  "title": "endpoint-locality-cases.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "description",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "endpoint-locality-cases.v1"
    },
    "description": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "local",
          "why"
        ],
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 256
          },
          "local": {
            "type": "boolean"
          },
          "why": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      }
    }
  }
}
