{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sekacorn/ai-infrastructure-suite/schemas/agent-memory-import.schema.json",
  "title": "agent-memory-import.v1",
  "description": "What a destination system did when it imported one agent-memory.v1 export. Written by the importer and bound to the export by its SHA-256. That the import ran is the importer's statement; the reader verifies the binding and that the counts account for every item and tombstone in the export.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_by", "import", "source_export", "stores"],
  "properties": {
    "schema_version": { "const": "agent-memory-import.v1" },
    "generated_by": {
      "description": "A producer string. Not trusted.",
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "version"],
      "properties": {
        "tool": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "import": {
      "type": "object",
      "additionalProperties": false,
      "required": ["import_id", "imported_at", "destination"],
      "properties": {
        "import_id": { "$ref": "#/$defs/identifier" },
        "imported_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
        },
        "destination": {
          "description": "The importing system and backend kind. Never a DSN, path, URL or credential.",
          "type": "object",
          "additionalProperties": false,
          "required": ["system", "backend"],
          "properties": {
            "system": { "$ref": "#/$defs/identifier" },
            "backend": { "$ref": "#/$defs/identifier" }
          }
        }
      }
    },
    "source_export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["export_id", "sha256"],
      "properties": {
        "export_id": { "$ref": "#/$defs/identifier" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "stores": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "description": "received = imported + unchanged + refused. Every received item is accounted for.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_store_id",
          "destination_store_id",
          "received",
          "imported",
          "unchanged",
          "refused",
          "tombstones_applied"
        ],
        "properties": {
          "source_store_id": { "$ref": "#/$defs/identifier" },
          "destination_store_id": { "$ref": "#/$defs/identifier" },
          "received": { "$ref": "#/$defs/count" },
          "imported": { "$ref": "#/$defs/count" },
          "unchanged": { "$ref": "#/$defs/count" },
          "refused": { "$ref": "#/$defs/count" },
          "tombstones_applied": { "$ref": "#/$defs/count" }
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "count": { "type": "integer", "minimum": 0, "maximum": 100000 }
  }
}
